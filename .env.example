# ------------------------------------------------------------
# Copia estos nombres en Coolify -> tu aplicación -> Environment
# Variables. Nunca subas valores reales al repositorio.
# ------------------------------------------------------------

# Supabase (Project Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU-ANON-KEY

# SECRETA. Salta RLS por completo: solo la usa el servidor y
# nunca llega al navegador. Si se filtra, rótala en Supabase.
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Google Cloud Vision (obligatoria: hace el OCR)
GOOGLE_VISION_API_KEY=TU-LLAVE-DE-VISION

# Anthropic (opcional: respaldo cuando el parser no reconoce el banco)
ANTHROPIC_API_KEY=

# Solo se aceptan comprobantes dirigidos a esta línea SINPE.
# Si lo dejás vacío, se acepta cualquier destinatario.
SINPE_TELEFONO=71096863
SINPE_TITULAR=Elvia Damaris Bravo Vargas

# Lista de artistas del show, separados por coma
ARTISTAS=Daddy Yankee,Shakira,Marc Anthony,Selena,Karol G,Celia Cruz

# Diagnóstico: con "true" imprime en los logs el texto que leyó
# el OCR. Sirve para ajustar el parser ante un banco nuevo.
# Dejalo apagado en uso normal: los logs mostrarían nombres y
# montos de la gente.
DEBUG_OCR=false

PORT=3000

# Ponlo en "false" solo si la app NO está detrás de un proxy.
CONFIAR_EN_PROXY=true
